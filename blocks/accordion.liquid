{% liquid
  assign block_settings = block.settings

  # Only collapse when there is actually something to reveal - a "Load more" under a list
  # that is already complete is a button that does nothing.
  assign visible_count = block_settings.visible_count | default: 4
  assign load_more = false
  if block_settings.enable_load_more and visible_count > 0 and block.blocks.size > visible_count
    assign load_more = true
  endif
%}

{% render 'contrast-override',
  background_color: block_settings.background_color,
  text_color: block_settings.text_color,
  section_id: block.id
%}

<div
  class="accordion accordion--{{ block.id }} accordion--{{ block_settings.icon }} border-style spacing-style{% if block_settings.background_color != blank or block_settings.text_color != blank %} color-custom-{{ block.id }}{% endif %}{% if block_settings.background_color != blank %} accordion--custom-background{% endif %}{% if block_settings.dividers %} accordion--dividers{% endif %}{% if load_more %} accordion--collapsed{% endif %}"
  style="
    --summary-font-family: var(--font-{{ block_settings.type_preset }}--family);
     --summary-font-style: var(--font-{{ block_settings.type_preset }}--style);
     --summary-font-weight: var(--font-{{ block_settings.type_preset }}--weight);
     --summary-font-size: var(--font-{{ block_settings.type_preset }}--size);
     --summary-font-line-height: var(--font-{{ block_settings.type_preset }}--line-height);
     --summary-font-case: var(--font-{{ block_settings.type_preset }}--case);
    {% render 'spacing-style', settings: block_settings %}
    {% render 'border-override', settings: block_settings %}
    {% if block_settings.divider_color != blank %} --color-border: {{ block_settings.divider_color }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}

  {%- if load_more -%}
    {%- comment -%}
      The cut-off has to be a literal in nth-child, which a custom property cannot supply, so
      the rule is written per block rather than living in the stylesheet below. Doing it in CSS
      rather than with script also means the extra rows are never painted and then withdrawn.
    {%- endcomment -%}
    {%- assign hide_from = visible_count | plus: 1 -%}
    <style>
      .accordion--{{ block.id }}.accordion--collapsed > accordion-custom:nth-child(n + {{ hide_from }}) {
        display: none;
      }
      /* The closing divider belongs to the last row still on screen, not to the real last
         child, which is hidden while collapsed. */
      .accordion--{{ block.id }}.accordion--collapsed.accordion--dividers
        > accordion-custom:nth-child({{ visible_count }})
        .details {
        border-block-end: calc(var(--style-border-width) * var(--show-fallback-borders)) solid
          var(--color-border);
      }
    </style>

    <button
      class="accordion__load-more"
      type="button"
      data-accordion-load-more="{{ visible_count }}"
    >
      {{- block_settings.load_more_label | default: 'Load More' -}}
    </button>
  {%- endif -%}
</div>

{% render 'accordion-styles' %}

{% stylesheet %}
  .accordion__load-more {
    display: block;
    margin-block-start: var(--padding-lg);
    margin-inline: auto;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-family: inherit;
    font-size: var(--font-size--sm);
    letter-spacing: var(--letter-spacing--body-loose);
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 6px;
    cursor: pointer;
  }

  .accordion__load-more:hover {
    opacity: var(--opacity-subdued-text, 0.7);
  }
{% endstylesheet %}

{% javascript %}
  // Delegated so it covers every accordion on the page, and any rendered later by the
  // section rendering API, without holding a reference to markup that may be replaced.
  document.addEventListener('click', (event) => {
    const button = event.target.closest('[data-accordion-load-more]');
    if (!button) return;

    const accordion = button.closest('.accordion');
    if (!accordion) return;

    accordion.classList.remove('accordion--collapsed');
    button.remove();

    // Move focus to the first row that had been hidden, so a keyboard user carries on from
    // where the list grew rather than being dropped back at the top of the document.
    const shown = parseInt(button.dataset.accordionLoadMore, 10);
    const rows = accordion.querySelectorAll('accordion-custom');
    const revealed = Number.isFinite(shown) ? rows[shown] : null;
    revealed?.querySelector('summary')?.focus({ preventScroll: true });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:names.accordion",
  "tag": null,
  "class": "accordion",
  "blocks": [
    {
      "type": "_accordion-row"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "caret",
          "label": "t:options.caret"
        },
        {
          "value": "plus",
          "label": "t:options.plus"
        }
      ],
      "default": "caret"
    },
    {
      "type": "checkbox",
      "id": "dividers",
      "label": "t:settings.dividers",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.dividers }}"
    },
    {
      "type": "checkbox",
      "id": "enable_load_more",
      "label": "Show a few rows at a time",
      "default": false,
      "info": "Hides the rest behind a button, the way the live FAQ does."
    },
    {
      "type": "number",
      "id": "visible_count",
      "label": "Rows shown",
      "default": 4,
      "visible_if": "{{ block.settings.enable_load_more }}"
    },
    {
      "type": "text",
      "id": "load_more_label",
      "label": "Button label",
      "default": "Load More",
      "visible_if": "{{ block.settings.enable_load_more }}"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "t:settings.heading_preset",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        }
      ],
      "default": "h6",
      "info": "t:info.edit_presets_in_theme_settings"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.accordion",
      "category": "t:categories.layout",
      "blocks": {
        "row-1": {
          "type": "_accordion-row",
          "settings": {
            "open_by_default": true,
            "heading": "t:text_defaults.return_policy"
          },
          "blocks": {
            "text-1": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.goal_for_every_customer",
                "width": "100%"
              }
            }
          },
          "block_order": ["text-1"]
        },
        "row-2": {
          "type": "_accordion-row",
          "settings": {
            "heading": "t:text_defaults.shipping"
          },
          "blocks": {
            "text-1": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.work_quickly_to_ship",
                "width": "100%"
              }
            }
          },
          "block_order": ["text-1"]
        },
        "row-3": {
          "type": "_accordion-row",
          "settings": {
            "heading": "t:text_defaults.manufacturing"
          },
          "blocks": {
            "text-1": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.made_local_and_global",
                "width": "100%"
              }
            }
          },
          "block_order": ["text-1"]
        }
      },
      "block_order": ["row-1", "row-2", "row-3"]
    }
  ]
}
{% endschema %}
