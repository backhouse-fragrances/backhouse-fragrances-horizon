{%- liquid
  assign product_has_swatches = false
  for product_option in closest.product.options_with_values
    assign swatch_count = product_option.values | map: 'swatch' | compact | size
    if swatch_count > 0
      assign product_has_swatches = true
      break
    endif
  endfor
-%}

{% capture product_card_children %}
  <div class="featured-product-content-top">
    {% content_for 'block', type: 'product-title', id: 'featured-product-title' %}

    {% content_for 'block', type: '_featured-product-price', id: 'featured-product-price' %}
  </div>
  {% content_for 'block', type: '_featured-product-gallery', id: 'featured-product-gallery' %}
  {% if product_has_swatches %}
    <div class="featured-product-content-bottom">
      {%- content_for 'block', type: 'swatches', id: 'featured-product-swatches' -%}
    </div>
  {% endif %}
  {% if block.settings.show_button and closest.product != blank %}
    <a href="{{ closest.product.url }}" class="button featured-product__button">
      {{- block.settings.button_label | escape -}}
    </a>
  {% endif %}
{% endcapture %}

{% render 'product-card',
  children: product_card_children,
  product: closest.product,
  product_card_gap: 8,
  product_view_context: 'page'
%}

{% stylesheet %}
  .featured-product-content-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--gap-sm);
  }

  /* Optional "Show button" CTA under the product image, linking to the selected product. */
  .featured-product__button {
    margin-block-start: var(--gap-sm);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_card"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "info": "Links to the selected product",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now",
      "visible_if": "{{ block.settings.show_button }}"
    }
  ]
}
{% endschema %}
