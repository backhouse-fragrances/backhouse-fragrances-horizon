{%- doc -%}
  A contact form with separate name, company and message fields.

  Horizon's own `contact-form` block posts name / email / phone / comment. The gifting
  enquiry form on the live storefront collects first name, last name, company, email and a
  project brief instead, and company in particular is worth capturing on a B2B enquiry - so
  this is a sibling block rather than an edit to the vendor one, which would conflict at the
  next Horizon version bump.

  Field names match the live form exactly (`contact[first_name]`, `contact[last_name]`,
  `contact[company]`, `contact[email]`, `contact[body]`) so the notification emails read the
  same as the ones the team already receives.

  Markup and classes are deliberately shared with `contact-form.liquid`, whose
  `{% stylesheet %}` compiles into the theme's stylesheet whether or not that block is used.
  That keeps the two forms visually identical for free - at the cost of theme check's
  ValidScopedCSSClass warning, which is the intended trade here rather than a second copy of
  the same rules.

  The submit button is the same `contact-form-submit-button` block the vendor form renders,
  so its label, style and width stay editable in the theme editor.
{%- enddoc -%}

{% capture submit_button %}
  {% content_for 'block', type: 'contact-form-submit-button', id: 'submit-button' %}
{% endcapture %}

{% liquid
  assign block_settings = block.settings
  assign form_id = block.id | default: section.id | prepend: 'ContactFormDetailed-'
%}

<div
  class="contact-form spacing-style size-style"
  style="
    {% render 'spacing-style', settings: block_settings %}
    {% render 'size-style', settings: block_settings %}
    {% if block_settings.background_color != blank %}background-color: {{ block_settings.background_color }};{% endif %}
    {% if block_settings.input_style == 'custom' %}
      {% render 'input-custom-styles', block_settings: block_settings %}
      --style-border-width-inputs: {{ block_settings.border_width }}px;
      --style-border-radius-inputs: {{ block_settings.border_radius }}px;
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
  {%- form 'contact', id: form_id, class: 'contact-form__form' -%}
    <input
      name="contact[id]"
      type="hidden"
      value="{{ form_id }}"
    >

    {% liquid
      assign form_matches = false
      if form.id == form_id or form.id == blank
        assign form_matches = true
      endif
    %}

    {%- if form.errors and form_matches -%}
      <div
        class="contact-form__error"
        tabindex="-1"
        autofocus
      >
        {{- 'icon-error.svg' | inline_asset_content -}}

        {{- form.errors.translated_fields.email | capitalize }}
        {{ form.errors.messages.email -}}
      </div>
    {%- endif -%}

    {%- if form.posted_successfully? and form_matches -%}
      <div
        class="contact-form__success"
        tabindex="-1"
        autofocus
      >
        {{- 'icon-checkmark.svg' | inline_asset_content -}}
        {{- 'blocks.contact_form.post_success' | t -}}
      </div>
    {%- endif -%}

    <div class="contact-form__form-row">
      <label class="visually-hidden" for="{{ form_id }}-first-name">
        {{- block_settings.first_name_label -}}
      </label>
      <input
        type="text"
        id="{{ form_id }}-first-name"
        class="contact-form__input"
        autocomplete="given-name"
        name="contact[first_name]"
        value="{{ form.first_name }}"
        placeholder="{{ block_settings.first_name_label | escape }}"
      >

      <label class="visually-hidden" for="{{ form_id }}-last-name">
        {{- block_settings.last_name_label -}}
      </label>
      <input
        type="text"
        id="{{ form_id }}-last-name"
        class="contact-form__input"
        autocomplete="family-name"
        name="contact[last_name]"
        value="{{ form.last_name }}"
        placeholder="{{ block_settings.last_name_label | escape }}"
      >
    </div>

    <div class="contact-form__form-row">
      <label class="visually-hidden" for="{{ form_id }}-company">
        {{- block_settings.company_label -}}
      </label>
      <input
        type="text"
        id="{{ form_id }}-company"
        class="contact-form__input"
        autocomplete="organization"
        name="contact[company]"
        value="{{ form.company }}"
        placeholder="{{ block_settings.company_label | escape }}"
      >

      <label class="visually-hidden" for="{{ form_id }}-email">
        {{- block_settings.email_label -}}
        <span aria-hidden="true">*</span>
      </label>
      <input
        type="email"
        id="{{ form_id }}-email"
        class="contact-form__input"
        autocomplete="email"
        name="contact[email]"
        spellcheck="false"
        autocapitalize="off"
        value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
        required
        aria-required="true"
        {% if form.errors contains 'email' and form_matches %}
          aria-invalid="true"
        {% endif %}
        placeholder="{{ block_settings.email_label | escape }}"
      >
    </div>

    <label class="visually-hidden" for="{{ form_id }}-body">
      {{- block_settings.message_label -}}
    </label>
    <textarea
      rows="5"
      id="{{ form_id }}-body"
      class="contact-form__input contact-form__input--textarea"
      name="contact[body]"
      placeholder="{{ block_settings.message_label | escape }}"
    >
      {{- form.body -}}
    </textarea>

    {{ submit_button }}
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contact form with company",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.text"
    },
    {
      "type": "text",
      "id": "first_name_label",
      "label": "First name",
      "default": "First Name"
    },
    {
      "type": "text",
      "id": "last_name_label",
      "label": "Last name",
      "default": "Last Name"
    },
    {
      "type": "text",
      "id": "company_label",
      "label": "Company",
      "default": "Company"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email",
      "default": "Email",
      "info": "Always required."
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message",
      "default": "Tell Us About Your Project"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.input"
    },
    {
      "type": "select",
      "id": "input_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default"
    },
    {
      "type": "color",
      "id": "input_background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.background }}",
      "visible_if": "{{ block.settings.input_style == 'custom' }}"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "t:settings.text_color",
      "default": "{{ settings.color_palette.foreground }}",
      "visible_if": "{{ block.settings.input_style == 'custom' }}"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "t:settings.border_color",
      "default": "{{ settings.color_palette.foreground }}",
      "visible_if": "{{ block.settings.input_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:settings.border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.input_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.input_style == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Contact form with company"
    }
  ]
}
{% endschema %}
