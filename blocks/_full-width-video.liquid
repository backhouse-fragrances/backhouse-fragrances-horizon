{%- doc -%}
  Renders a video that fills the full width of its container. Reuses the video
  snippet and the media settings of the video block, without its width, border and
  padding options. Renders nothing when no video is set, so the block can sit in a
  fixed slot (e.g. above a collection heading) without leaving a placeholder behind.

  A looping autoplay video is treated as a banner and rendered without player controls.
  The aspect ratio applies to uploaded and URL videos alike; "Custom" swaps it for a
  fixed desktop/mobile height. In both cases the media cover-crops to the box.

  @example
  {% content_for 'block', type: '_full-width-video', id: 'video' %}
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
  assign has_video = false

  if block_settings.source == 'uploaded' and block_settings.video != blank
    assign has_video = true
  elsif block_settings.source == 'url' and block_settings.video_url != blank
    assign has_video = true
  endif

  assign disable_controls = false
  if block_settings.video_autoplay and block_settings.video_loop
    assign disable_controls = true
  endif

  assign video_class = 'full-width-video'
  assign ratio = block_settings.aspect_ratio

  case block_settings.aspect_ratio
    when 'auto'
      # Uploaded videos keep their own ratio; YouTube and Vimeo embeds have no ratio to read
      if block_settings.source == 'uploaded'
        assign ratio = block_settings.video.aspect_ratio | default: '16/9'
      else
        assign ratio = '16/9'
      endif
    when 'custom'
      assign ratio = 'auto'
      assign video_class = video_class | append: ' full-width-video--custom-height'
    else
      assign video_class = video_class | append: ' full-width-video--ratio'
  endcase
%}

{% if has_video %}
  {% capture video_style %}
    --size-style-aspect-ratio: {{ ratio }};
    {% if block_settings.aspect_ratio == 'custom' %}
      --full-width-video-height: {{ block_settings.height_desktop }}px;
      --full-width-video-height-mobile: {{ block_settings.height_mobile }}px;
    {% endif %}
  {% endcapture %}

  {% if block_settings.source == 'uploaded' %}
    {% render 'video',
      video: block_settings.video,
      video_class: video_class,
      video_loop: block_settings.video_loop,
      video_style: video_style,
      video_preview_image: block_settings.video.preview_image,
      disable_controls: disable_controls,
      sizes: '100vw',
      additional_attributes: block.shopify_attributes
    %}
  {% else %}
    {% render 'video',
      video_from_url: true,
      video: block_settings.video_url.id,
      video_class: video_class,
      video_type: block_settings.video_url.type,
      video_style: video_style,
      video_alt: block_settings.alt,
      video_preview_image: block_settings.cover_image,
      disable_controls: disable_controls,
      sizes: '100vw',
      additional_attributes: block.shopify_attributes
    %}
  {% endif %}
{% endif %}

{% stylesheet %}
  .full-width-video {
    display: block;
    width: 100%;
  }

  /* Small uploads and poster images fill the width instead of sitting at their intrinsic size */
  .full-width-video > video,
  .full-width-video img {
    width: 100%;
  }

  /* Fixed ratio or custom height: the block sets the box and the media cover-crops to it */
  .full-width-video--ratio,
  .full-width-video--custom-height {
    overflow: hidden;
  }

  .full-width-video--ratio {
    aspect-ratio: var(--size-style-aspect-ratio);
  }

  .full-width-video--custom-height {
    height: var(--full-width-video-height-mobile);
  }

  .full-width-video--ratio > :is(video, .deferred-media__poster-button),
  .full-width-video--custom-height > :is(video, .deferred-media__poster-button) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    object-fit: cover;
  }

  /* An iframe cannot object-fit, so it is kept at 16:9, made at least as wide as the box
     (or as wide as the box height needs), and centred; the overflow above crops the rest. */
  .full-width-video--ratio > iframe,
  .full-width-video--ratio > .deferred-media__poster-button ~ iframe,
  .full-width-video--custom-height > iframe,
  .full-width-video--custom-height > .deferred-media__poster-button ~ iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    height: auto;
    max-width: none;
    aspect-ratio: 16 / 9;
  }

  .full-width-video--ratio > iframe,
  .full-width-video--ratio > .deferred-media__poster-button ~ iframe {
    width: max(100%, calc(100% * 16 / 9 / (var(--size-style-aspect-ratio))));
  }

  .full-width-video--custom-height > iframe,
  .full-width-video--custom-height > .deferred-media__poster-button ~ iframe {
    width: max(100%, calc(var(--full-width-video-height-mobile) * 16 / 9));
  }

  @media screen and (min-width: 750px) {
    .full-width-video--custom-height {
      height: var(--full-width-video-height);
    }

    .full-width-video--custom-height > iframe,
    .full-width-video--custom-height > .deferred-media__poster-button ~ iframe {
      width: max(100%, calc(var(--full-width-video-height) * 16 / 9));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.video",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "t:settings.video_source",
      "options": [
        {
          "value": "uploaded",
          "label": "t:options.video_uploaded"
        },
        {
          "value": "url",
          "label": "t:options.video_external_url"
        }
      ],
      "default": "uploaded"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video",
      "visible_if": "{{ block.settings.source == 'uploaded' }}"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "t:settings.video_external_url",
      "info": "t:info.video_external",
      "accept": ["youtube", "vimeo"],
      "visible_if": "{{ block.settings.source == 'url' }}"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "t:settings.video_autoplay",
      "info": "t:info.video_autoplay",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "t:settings.video_loop",
      "info": "Player controls are hidden when autoplay and loop are both on.",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:settings.cover_image",
      "visible_if": "{{ block.settings.source == 'url' and block.settings.video_autoplay == false }}"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "t:settings.video_alt_text",
      "info": "t:info.video_alt_text",
      "visible_if": "{{ block.settings.source == 'url' }}"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:settings.aspect_ratio",
      "info": "Auto keeps an uploaded video's own ratio; YouTube and Vimeo use 16:9.",
      "options": [
        {
          "value": "auto",
          "label": "t:options.auto"
        },
        {
          "value": "9/16",
          "label": "t:options.portrait"
        },
        {
          "value": "1/1",
          "label": "t:options.square"
        },
        {
          "value": "16/9",
          "label": "t:options.landscape"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "t:settings.desktop_height",
      "min": 200,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 500,
      "visible_if": "{{ block.settings.aspect_ratio == 'custom' }}"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "t:settings.mobile_height",
      "min": 150,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 320,
      "visible_if": "{{ block.settings.aspect_ratio == 'custom' }}"
    }
  ]
}
{% endschema %}
