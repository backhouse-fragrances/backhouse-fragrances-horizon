{%- doc -%}
  Product media gallery content styles extracted into a standalone snippet.

  @example
  {% render 'product-media-gallery-content-styles' %}
{%- enddoc -%}

{% stylesheet %}
  /* Product Media */
  media-gallery {
    display: block;
    width: 100%;
  }

  :where(media-gallery, .product-grid__item) {
    .media-gallery__grid {
      grid-template-columns: 1fr;
      gap: var(--image-gap);
    }
  }

  @media screen and (min-width: 750px) {
    .media-gallery--large-first-image .product-media-container:first-child,
    .media-gallery--two-column .product-media-container:only-child {
      /* First child spans 2 columns */
      grid-column: span 2;
    }
  }

  media-gallery:where(.media-gallery--grid) .media-gallery__grid {
    display: none;
  }

  media-gallery.media-gallery--grid .media-gallery__grid .product-media-container {
    /* Needed for safari to stretch to full grid height */
    height: 100%;
  }

  @media screen and (min-width: 750px) {
    .media-gallery--two-column .media-gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    /* Display grid view as a carousel on mobile, grid on desktop */
    media-gallery:is(.media-gallery--grid) slideshow-component {
      display: none;
    }

    media-gallery:where(.media-gallery--grid) .media-gallery__grid {
      display: grid;
    }
  }

  zoom-dialog dialog {
    width: 100vw;
    height: 100vh;
    border: none;
    margin: 0;
    padding: 0;
    max-width: 100%;
    max-height: 100%;
    background: #fff;
    opacity: 0;
    transition: opacity var(--animation-speed) var(--animation-easing);
    scrollbar-width: none;

    &[open] {
      opacity: 1;
    }

    @media (prefers-reduced-motion: no-preference) {
      scroll-behavior: smooth;
    }

    &::backdrop {
      background: transparent;
    }
  }

  .product-media-container__zoom-button {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: var(--layer-flat);
    cursor: zoom-in;
    background-color: transparent;

    &:hover {
      background-color: transparent;
    }
  }

  slideshow-slide.product-media-container--tallest {
    content-visibility: visible;
  }

  .product-media__drag-zoom-wrapper {
    aspect-ratio: inherit;
    min-height: inherit;
    min-width: inherit;
    display: inherit;
    flex: inherit;
  }

  .media-gallery__mobile-controls {
    grid-area: auto;
  }

  .product-media-container--zoomable.product-media-container--image {
    cursor: zoom-in;
  }

  /* Minimal lightbox: no thumbnail strip, previous / close / next under the image */
  .dialog-zoomed-gallery__dialog--minimal .dialog-thumbnails-list-container,
  .dialog-zoomed-gallery__dialog--minimal .dialog-zoomed-gallery__close-button {
    display: none;
  }

  /* One media at a time, fitted to the viewport; zoom-dialog.js toggles data-active. */
  .dialog-zoomed-gallery__dialog--minimal .dialog-zoomed-gallery {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100dvh;
    overflow: hidden;
    scroll-snap-type: none;
  }

  .dialog-zoomed-gallery__dialog--minimal .dialog-zoomed-gallery > .product-media-container:not([data-active]) {
    display: none;
  }

  .dialog-zoomed-gallery__dialog--minimal .dialog-zoomed-gallery > .product-media-container[data-active] {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  .dialog-zoomed-gallery__dialog--minimal .dialog-zoomed-gallery > .product-media-container[data-active] .product-media__drag-zoom-wrapper,
  .dialog-zoomed-gallery__dialog--minimal .dialog-zoomed-gallery > .product-media-container[data-active] .product-media {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  .dialog-zoomed-gallery__dialog--minimal .dialog-zoomed-gallery > .product-media-container[data-active] .product-media__image {
    --product-media-fit: contain;

    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100dvh;
    object-fit: contain;
  }

  .dialog-zoomed-gallery__controls {
    position: fixed;
    inset-inline: 0;
    bottom: 2.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    z-index: var(--layer-raised);
    pointer-events: none;
    padding-block-end: var(--safe-area-inset-bottom);
  }

  .dialog-zoomed-gallery__control {
    --control-size: 2.75rem;

    pointer-events: auto;
    width: var(--control-size);
    height: var(--control-size);
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-background);
    color: var(--color-foreground);
    box-shadow: 0 0.125rem 0.625rem rgb(var(--color-foreground-rgb) / 0.15);
    cursor: pointer;
    transition: transform 0.2s ease-in-out;

    svg {
      width: 0.75rem;
      height: auto;
    }
  }

  .dialog-zoomed-gallery__control--close {
    --control-size: 3.125rem;

    svg {
      width: 1rem;
    }
  }

  @media screen and (min-width: 750px) {
    .dialog-zoomed-gallery__controls {
      gap: 1.125rem;
    }

    .dialog-zoomed-gallery__control--close {
      --control-size: 3.5rem;
    }
  }

  /* .button-unstyled:hover inherits the (transparent) parent background; keep the disc. */
  .dialog-zoomed-gallery__control:is(:hover, :focus-visible) {
    background: var(--color-background);
    color: var(--color-foreground);
  }

  @media screen and (pointer: fine) {
    .dialog-zoomed-gallery__control:hover {
      transform: scale(1.1);
    }
  }

  /* Icon slides out and back in on hover: sideways for previous / next, downwards for close. */
  @media (prefers-reduced-motion: no-preference) {
    .dialog-zoomed-gallery__control:hover svg {
      animation: dialog-zoomed-gallery-icon-inline 0.35s ease-in-out forwards;
    }

    .dialog-zoomed-gallery__control--close:hover svg {
      animation-name: dialog-zoomed-gallery-icon-block;
    }
  }

  @keyframes dialog-zoomed-gallery-icon-inline {
    0% {
      opacity: 1;
      transform: translateX(0);
    }

    50% {
      opacity: 0;
      transform: translateX(100%);
    }

    51% {
      opacity: 0;
      transform: translateX(-100%);
    }

    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes dialog-zoomed-gallery-icon-block {
    0% {
      opacity: 1;
      transform: translateY(0);
    }

    50% {
      opacity: 0;
      transform: translateY(100%);
    }

    51% {
      opacity: 0;
      transform: translateY(-100%);
    }

    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Grid presentation with a left thumbnail rail (block_settings.grid_desktop_pagination = thumbnails).
     Sizing mirrors the carousel thumbnails in slideshow-controls. */
  .media-gallery__grid-thumbnails {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .media-gallery--grid-thumbnails .media-gallery__grid-layout {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: var(--gap-sm);
      align-items: start;
    }

    /* Same header-aware offset Horizon gives the sticky product details */
    body:has(#header-group #header-component[data-sticky-state='active']) .media-gallery--grid-thumbnails {
      --sticky-header-offset: var(--header-height);
    }

    .media-gallery__grid-thumbnails {
      position: sticky;
      top: var(--sticky-header-offset, 0px);
      display: flex;
      flex-direction: column;
      gap: var(--gap-xs);
      /* Room for the selected ring (outline + offset) on every side; the rail is pulled left by the same
         amount so thumbnails still align with the page margin. Needed because overflow clips the ring. */
      --thumbnail-ring-space: calc(var(--focus-outline-offset) + var(--focus-outline-width));

      max-height: calc(100vh - var(--sticky-header-offset, 0px));
      padding: var(--thumbnail-ring-space);
      margin-inline-start: calc(-1 * var(--thumbnail-ring-space));
      overflow: hidden auto;
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }
    }

    .media-gallery__grid-thumbnail {
      position: relative;
      flex: none;
      width: clamp(44px, 7vw, var(--thumbnail-width));
      height: auto;
      aspect-ratio: var(--aspect-ratio);
      border-radius: var(--thumbnail-radius, var(--media-radius));

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: var(--thumbnail-radius, var(--media-radius));
      }

      &[aria-selected='true'] {
        outline: var(--focus-outline-width) solid currentcolor;
        outline-offset: calc(var(--focus-outline-offset) / 2);
        border: var(--style-border-width) solid rgb(var(--color-border-rgb) / var(--media-border-opacity));
      }
    }

    .media-gallery__grid-thumbnail-badge {
      position: absolute;
      top: var(--padding-2xs);
      right: var(--padding-2xs);
      width: clamp(16px, 10%, 20px);
      height: clamp(16px, 10%, 20px);
      background-color: var(--color-background);
      border-radius: var(--style-border-radius-xs);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 0 1px rgb(var(--color-foreground-rgb) / var(--opacity-5));

      svg {
        width: 60%;
        height: 60%;
        fill: var(--color-foreground);
        opacity: 0.6;
      }
    }

    /* Leave room for the sticky header when a thumbnail scrolls its media into view */
    .media-gallery--grid-thumbnails .media-gallery__grid > .product-media-container {
      scroll-margin-top: calc(var(--sticky-header-offset, 0px) + var(--sticky-bar-offset, 0px) + var(--image-gap, 0px));
    }
  }
{% endstylesheet %}
