<script
  src="{{ 'gift-card-recipient-form.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- comment -%}
  Elements for the blocks kept in the modal (data-quick-add-keep). The modal's content is
  fetched and morphed in, and a script tag that arrives that way never runs, so the blocks'
  own script tags do nothing there.
{%- endcomment -%}
<script
  src="{{ 'personalizer-options.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'product-addons.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'dialog-styles' %}

<quick-add-dialog id="quick-add-dialog">
  <dialog
    class="quick-add-modal dialog-modal color-custom-popover"
    ref="dialog"
    scroll-lock
  >
    <button
      ref="closeButton"
      on:click="/closeDialog"
      class="button button-unstyled close-button quick-add-modal__close"
      aria-label="{{ 'accessibility.close_dialog' | t }}"
    >
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>

    <product-component
      id="quick-add-modal-content"
      class="quick-add-modal__content"
      view-event-trigger="dialog"
    ></product-component>
  </dialog>
</quick-add-dialog>

{% render 'product-media-container-styles' %}
{% render 'quick-add-modal-styles' %}
{% render 'product-media-gallery-content-styles' %}
{% render 'payment-terms-styles' %}
