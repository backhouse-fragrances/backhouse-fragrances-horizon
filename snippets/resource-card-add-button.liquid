{%- doc -%}
  Renders a small "Add" button for a resource card (used by the cart recommendations
  widget). Reuses Horizon's own add-to-cart mechanism: a `product-form-component`
  wrapping a `{% form 'product' %}`, the same pattern `snippets/quick-add.liquid` uses
  for its single-variant "Add" path. Submitting it adds via AJAX and dispatches the
  standard cart-lines-update event, which is what makes the cart drawer refresh and the
  cart-recommendations widget re-fetch (filtering the added product out).

  Products with more than one variant render a link to the product page instead of a
  form: this card is injected into the DOM client-side by cart-recommendations.js
  (fetched, not morphed) and carries no variant picker of its own, so the shopper
  chooses on the PDP.

  A product with personalizer options or add-ons (the metafields read by
  blocks/_personalizer-options.liquid and blocks/_product-addons.liquid) is not added
  directly either, even with a single variant: that would skip the choices. Its button
  opens Horizon's quick-add modal over the cart drawer, the same one product cards use
  (snippets/quick-add.liquid), which holds those blocks. The component takes the product
  page from data-product-url, since there is no product card around it. The modal is only
  rendered when quick add is on (layout/theme.liquid), so without it the link is used.

  @param {object} product - The product to render the button for.
  @param {string} [section_id] - The section id to pass through to the add button's
    product form (data-section-id). Matches the pattern in snippets/quick-add.liquid and
    blocks/buy-buttons.liquid.

  @example
  {% render 'resource-card-add-button', product: resource, section_id: section.id %}
{%- enddoc -%}

{% liquid
  assign variant = product.selected_or_first_available_variant
  assign can_add_to_cart = false
  if variant.available
    assign can_add_to_cart = true
  endif
  assign add_to_cart_text = 'actions.add' | t
  assign choose_text = 'actions.choose' | t
  assign product_form_id = 'ResourceCard-ProductForm-' | append: product.id

  assign personalizer_options = product.metafields.personalizer.options.value
  assign product_addons = product.metafields.custom.addons.value
  assign has_shopper_choices = false
  if personalizer_options != blank and personalizer_options.size > 0
    assign has_shopper_choices = true
  endif
  if product_addons != blank and product_addons.size > 0
    assign has_shopper_choices = true
  endif

  # The same condition layout/theme.liquid renders the quick-add modal under.
  assign has_quick_add_modal = false
  if settings.quick_add or settings.mobile_quick_add
    assign has_quick_add_modal = true
  endif
%}

<div class="resource-card__add-button">
  {%- if product.has_only_default_variant and has_shopper_choices == false -%}
    <product-form-component
      data-section-id="{{ section_id }}"
      data-product-id="{{ product.id }}"
      on:submit="/handleSubmit"
    >
      <div
        class="visually-hidden"
        aria-live="assertive"
        role="status"
        aria-atomic="true"
        ref="liveRegion"
      ></div>
      {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
        <input
          type="hidden"
          name="id"
          ref="variantId"
          value="{{ variant.id }}"
          {% if variant.available == false %}
            disabled
          {% endif %}
        >
        <input
          type="hidden"
          name="quantity"
          value="1"
        >
        {% render 'add-to-cart-button',
          add_to_cart_text: add_to_cart_text,
          class: 'add-to-cart-button',
          can_add_to_cart: can_add_to_cart,
          show_icon: false,
          product: product
        %}
      {%- endform -%}
    </product-form-component>
  {%- elsif has_shopper_choices and has_quick_add_modal -%}
    <quick-add-component
      data-product-title="{{ product.title }}"
      data-product-url="{{ product.url }}"
    >
      <button
        type="button"
        class="button"
        on:click="quick-add-component/handleClick"
      >
        {{- choose_text -}}
      </button>
    </quick-add-component>
  {%- else -%}
    <a
      href="{{ product.url }}"
      class="button"
    >
      {{- choose_text -}}
    </a>
  {%- endif -%}
</div>

{% render 'add-to-cart-button-styles' %}

{% stylesheet %}
  /*
    resource-card's full-card overlay link (.resource-card__link, absolutely
    positioned) would otherwise sit over this button and swallow the click - the
    same problem quick-add solves with --layer-raised.
  */
  .resource-card__add-button {
    position: relative;
    z-index: var(--layer-raised, 2);
  }

  /* The quick-add element wraps a block-level button; as an inline element it would split around it. */
  .resource-card__add-button quick-add-component {
    display: block;
  }

  /*
    A clear rectangle at touch-target height. Horizon sets an explicit height on
    .button (52px here), so min-height alone cannot shorten it; set height too. The
    element selectors keep this ahead of any equal-specificity theme rule.
  */
  .resource-card__add-button button.button,
  .resource-card__add-button a.button {
    min-width: 96px;
    height: var(--minimum-touch-target, 44px);
    min-height: var(--minimum-touch-target, 44px);
    padding-block: 0;
    padding-inline: var(--padding-xl, 24px);
    font-size: var(--font-size--body-sm, 0.875rem);
  }
{% endstylesheet %}
