{% doc %}
  Renders the `<cart-recommendations>` placeholder that seeds and fetches the cart
  recommendations (upsell) widget via the Section Rendering API. Used both by
  `sections/cart-recommendations.liquid` (cart page, reading its own settings) and by
  `snippets/cart-drawer.liquid` (the drawer, which has no section of its own settings to
  read, so it points at that same section's id and passes its schema defaults directly).

  Renders nothing when the cart is empty or no seed product id is available.

  @param {number} [product_id] - The seed product id to request recommendations for.
  @param {string} section_id - The id of the `cart-recommendations` section whose stored
    settings render the fetched results (its section id in templates/cart.json).
  @param {string} [intent] - 'related' or 'complementary'. Defaults to 'related'.
  @param {number} [limit] - Maximum number of products to request. Defaults to 3.

  @example
  {% render 'cart-recommendations',
    product_id: cart.items.last.product_id,
    section_id: 'cart-recommendations',
    intent: 'related',
    limit: 3
  %}
{% enddoc %}

{%- liquid
  assign intent = intent | default: 'related'
  assign limit = limit | default: 3
-%}

{%- if cart.item_count > 0 and product_id != blank and section_id != blank -%}
  {%- comment -%}
    data-skip-node-update: Horizon re-renders the drawer in place on every cart
    change. This element's children are injected client-side and do not exist in
    the server render, so without it the morph walk reconciles a full subtree
    against an empty one and takes the cart line items with it.
  {%- endcomment -%}
  <cart-recommendations
    id="cart-recommendations-{{ section_id }}"
    class="cart-recommendations"
    data-url="{{ routes.product_recommendations_url }}?limit={{ limit }}"
    data-section-id="{{ section_id }}"
    data-product-id="{{ product_id }}"
    data-intent="{{ intent }}"
    data-testid="cart-recommendations"
    data-skip-node-update
  >
    <div
      ref="container"
      class="cart-recommendations__container"
    ></div>
  </cart-recommendations>
{%- endif -%}

{% stylesheet %}
  cart-recommendations {
    display: block;
  }

  /*
    In the cart drawer the fetched section renders inside a ~480px panel, so the
    page-width gutters it uses on the cart page do not fit. Scoped to the drawer
    wrapper so the cart page instance is untouched.
  */
  /*
    .cart-drawer__items does not grow, so with a short cart the sticky summary
    leaves dead space above itself. Let the items box grow only while the widget
    is present, and push the widget to its bottom, so it sits directly above the
    gift-message collapse. Grow, never shrink-to-zero: a long cart still scrolls.
  */
  .cart-drawer__items:has(> .cart-drawer__recommendations cart-recommendations) {
    flex-grow: 1;
  }

  /*
    The carets overhang into the side padding only; never show a horizontal bar.
    Which box scrolls depends on the summary-sticky setting: the items box when
    sticky, .cart-drawer__content when not (Horizon then sets the items box to
    overflow: unset at higher specificity). Clip both, with enough specificity to
    hold in either mode.
  */
  .theme-drawer__dialog .cart-drawer__items:has(> .cart-drawer__recommendations cart-recommendations),
  .theme-drawer__dialog .cart-drawer__content:has(cart-recommendations) {
    overflow-x: clip;
  }

  .cart-drawer__items > .cart-drawer__recommendations {
    margin-block-start: auto;
  }

  .cart-drawer__recommendations .cart-recommendations__inner {
    /* .cart-drawer__items already pads its contents; only separate from the last line. */
    padding-inline: 0;
    margin-block-start: var(--padding-xl, 24px);
    /*
      The section's bottom padding setting (48px; spacing-style floors it at 20px on
      mobile) would sit between the dots and the summary. The summary brings its own
      16px, so the widget ends at the dots and sits on the summary.
    */
    padding-block-end: 0;
    display: block;
  }

  /*
    display: block above drops the section's own flex gap between the heading and
    the list, so the heading carries its own margins in the drawer.
  */
  .cart-drawer__recommendations .cart-recommendations__heading {
    margin-block-start: var(--padding-xl, 24px);
    margin-block-end: var(--padding-lg, 16px);
  }

  /*
    resource-list-carousel sizes slides with clamp(150px, --mobile-card-size,
    --slide-width-max). The arrows are an absolute overlay spread across the slide
    (justify-content: space-between), so on a full-width slide the right arrow lands
    on the Add button. Give each arrow a gutter instead: the slide gives up that
    width, the track pads by it, and the arrows container spans the whole track so
    the buttons sit in the gutters, off the card.
  */
  /*
    The card spans the full content width, so its edges line up exactly with the
    cart line above it. The carets are pulled outward instead (see slideshow-arrows
    below): each straddles a card edge, overhanging only into the drawer's own side
    padding, which is wider than half a caret, so nothing is ever clipped. cqw here
    is the carousel's own width, i.e. the content box.
  */
  .cart-drawer__recommendations .resource-list__carousel {
    /* Carets at 85% of the touch target, per review. */
    --cart-rec-arrow-size: calc(var(--minimum-touch-target, 44px) * 0.85);
    /*
      Half a caret, but never within 2px of the drawer's side padding: on Windows a
      classic vertical scrollbar takes width inside the scroll region, and an overhang
      that lands on the padding edge can tip into horizontal overflow by rounding.
    */
    --cart-rec-arrow-half: min(calc(var(--cart-rec-arrow-size) / 2), calc(var(--cart-drawer-padding, 20px) - 2px));
    --mobile-card-size: 100cqw;
    --slide-width-max: 100%;
  }

  /*
    slideshow-container is overflow-x: clip, which cuts the half of each caret that
    overhangs the card. The slides are clipped by the slideshow-slides scroll
    container itself, so freeing the wrapper only lets the carets show in full; they
    stay inside the drawer's own side padding.
  */
  .cart-drawer__recommendations .resource-list__carousel slideshow-container {
    overflow-x: visible;
  }

  .cart-drawer__recommendations .resource-list__carousel slideshow-arrows {
    /* Extend the arrows layer half a caret past each card edge so the carets straddle them. */
    inset-inline: calc(-1 * var(--cart-rec-arrow-half));
    width: auto;
    padding-inline: 0;
    align-items: center;
    /* Horizon blends arrows into imagery; on a white card that hides the square. */
    mix-blend-mode: normal;
  }

  .cart-drawer__recommendations .resource-list__carousel slideshow-arrows .slideshow-control {
    /* Always visible in the drawer; Horizon reveals them on hover only. */
    opacity: 1;
    width: var(--cart-rec-arrow-size);
    height: var(--cart-rec-arrow-size);
    min-width: var(--cart-rec-arrow-size);
    min-height: var(--cart-rec-arrow-size);
    padding: 0;
  }

  /* Grey square with a dark caret; Horizon's default is the button colour. */
  .cart-drawer__recommendations .resource-list__carousel slideshow-arrows .slideshow-control--shape-square {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10, 0.1));
    color: var(--color-foreground);
  }

  /*
    Each recommendation is a bordered box: thumbnail left, title and price right,
    Add button bottom-right. The stock resource-card becomes display: contents so
    its media and content take part in this grid directly.
  */
  /*
    Every box fills its slide so all cards are the same height while sliding and
    the arrows, which Horizon centres on the track, land at 50% of every card.
    Row 1 takes the slack so the Add button stays on the bottom edge.
  */
  .cart-drawer__recommendations .resource-list__slide > .resource-list__item {
    height: 100%;
  }

  .cart-drawer__recommendations .cart-recommendations__item {
    position: relative;
    height: 100%;
    box-sizing: border-box;
    display: grid;
    /* thumb | title (spans 2-3) then price | Add button on the second row */
    grid-template-columns: 84px 1fr auto;
    grid-template-rows: 1fr auto;
    column-gap: var(--padding-md, 12px);
    row-gap: var(--padding-sm, 8px);
    align-items: center;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-15, 0.15));
    padding: var(--padding-sm, 8px);
  }

  /*
    resource-card renders as product-component.resource-card__wrapper > .resource-card >
    (link, media, content). Both wrappers must flatten, or the wrapper sits in column 1
    as one box and the media, title and price all stack inside 84px.
  */
  .cart-drawer__recommendations .cart-recommendations__item .resource-card__wrapper,
  .cart-drawer__recommendations .cart-recommendations__item .resource-card {
    display: contents;
  }

  .cart-drawer__recommendations .cart-recommendations__item .resource-card__media {
    grid-column: 1;
    grid-row: 1 / 3;
  }

  /*
    The content block (title + price) flattens too, so the price can sit on the
    Add button's row and the card loses a row of height.
  */
  .cart-drawer__recommendations .cart-recommendations__item .resource-card__content {
    display: contents;
  }

  .cart-drawer__recommendations .cart-recommendations__item .resource-card__content > .resource-card__title {
    grid-column: 2 / 4;
    grid-row: 1;
    margin: 0;
    /* The caret overlaps the card by half its width; keep text out from under it. */
    padding-inline-end: var(--cart-rec-arrow-half);
  }

  .cart-drawer__recommendations .cart-recommendations__item .resource-card__content > :not(.resource-card__title) {
    grid-column: 2;
    grid-row: 2;
    align-self: center;
    margin: 0;
  }

  .cart-drawer__recommendations .cart-recommendations__item .resource-card__add-button {
    grid-column: 3;
    grid-row: 2;
    justify-self: end;
    margin-inline-end: var(--cart-rec-arrow-half);
  }
{% endstylesheet %}
