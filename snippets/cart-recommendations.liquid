{% doc %}
  Renders the `<cart-recommendations>` placeholder that seeds and fetches the cart
  recommendations (upsell) widget via the Section Rendering API. Used both by
  `sections/cart-recommendations.liquid` (cart page, reading its own settings) and by
  `snippets/cart-drawer.liquid` (the drawer, which has no section of its own settings to
  read, so it points at that same section's id and passes its schema defaults directly).

  Renders nothing when the cart is empty or no seed product id is available.

  @param {number} [product_id] - The seed product id to request recommendations for.
  @param {string} section_id - The id of the `cart-recommendations` section whose stored
    settings render the fetched results (its section id in templates/cart.json).
  @param {string} [intent] - 'related' or 'complementary'. Defaults to 'related'.
  @param {number} [limit] - Maximum number of products to request. Defaults to 3.

  @example
  {% render 'cart-recommendations',
    product_id: cart.items.last.product_id,
    section_id: 'cart-recommendations',
    intent: 'related',
    limit: 3
  %}
{% enddoc %}

{%- liquid
  assign intent = intent | default: 'related'
  assign limit = limit | default: 3
-%}

{%- if cart.item_count > 0 and product_id != blank and section_id != blank -%}
  {%- comment -%}
    data-skip-node-update: Horizon re-renders the drawer in place on every cart
    change. This element's children are injected client-side and do not exist in
    the server render, so without it the morph walk reconciles a full subtree
    against an empty one and takes the cart line items with it.
  {%- endcomment -%}
  <cart-recommendations
    id="cart-recommendations-{{ section_id }}"
    class="cart-recommendations"
    data-url="{{ routes.product_recommendations_url }}?limit={{ limit }}"
    data-section-id="{{ section_id }}"
    data-product-id="{{ product_id }}"
    data-intent="{{ intent }}"
    data-testid="cart-recommendations"
    data-skip-node-update
  >
    <div
      ref="container"
      class="cart-recommendations__container"
    ></div>
  </cart-recommendations>
{%- endif -%}

{% stylesheet %}
  cart-recommendations {
    display: block;
  }

  /*
    In the cart drawer the fetched section renders inside a ~480px panel, so the
    page-width gutters it uses on the cart page do not fit. Scoped to the drawer
    wrapper so the cart page instance is untouched.
  */
  .cart-drawer__recommendations .cart-recommendations__inner {
    /* .cart-drawer__items already pads its contents; only separate from the last line. */
    padding-inline: 0;
    margin-block-start: var(--padding-xl, 24px);
    display: block;
  }

  /*
    display: block above drops the section's own flex gap between the heading and
    the list, so the heading carries its own margins in the drawer.
  */
  .cart-drawer__recommendations .cart-recommendations__heading {
    margin-block-start: var(--padding-xl, 24px);
    margin-block-end: var(--padding-lg, 16px);
  }

  /*
    One slide fills the drawer width. resource-list-carousel sizes slides with
    clamp(150px, --mobile-card-size, --slide-width-max); feed both so it resolves
    to the full width.
  */
  .cart-drawer__recommendations .resource-list__carousel {
    --mobile-card-size: 100cqw;
    --slide-width-max: 100%;
  }

  /*
    Each recommendation is a bordered box: thumbnail left, title and price right,
    Add button bottom-right. The stock resource-card becomes display: contents so
    its media and content take part in this grid directly.
  */
  .cart-drawer__recommendations .cart-recommendations__item {
    position: relative;
    display: grid;
    grid-template-columns: 84px 1fr;
    grid-template-rows: auto auto;
    column-gap: var(--padding-md, 12px);
    row-gap: var(--padding-sm, 8px);
    align-items: center;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-15, 0.15));
    padding: var(--padding-sm, 8px);
  }

  /*
    resource-card renders as product-component.resource-card__wrapper > .resource-card >
    (link, media, content). Both wrappers must flatten, or the wrapper sits in column 1
    as one box and the media, title and price all stack inside 84px.
  */
  .cart-drawer__recommendations .cart-recommendations__item .resource-card__wrapper,
  .cart-drawer__recommendations .cart-recommendations__item .resource-card {
    display: contents;
  }

  .cart-drawer__recommendations .cart-recommendations__item .resource-card__media {
    grid-column: 1;
    grid-row: 1 / 3;
  }

  .cart-drawer__recommendations .cart-recommendations__item .resource-card__content {
    grid-column: 2;
    grid-row: 1;
    padding-block: 0;
  }

  .cart-drawer__recommendations .cart-recommendations__item .resource-card__add-button {
    grid-column: 2;
    grid-row: 2;
    justify-self: end;
  }
{% endstylesheet %}
