{% doc %}
  Renders the thin-line icon inside a cart rewards tier marker.

  All three icons share one 24 x 24 grid, a 1.5 stroke, round caps and joins and no fills, and each
  is drawn around the centre of the grid (12, 12) so it sits optically centred in the round marker.
  The size is set by `.cart-rewards__icon` and is the same on every viewport.

  @param {string} [reward_type] - 'Free shipping' (truck), 'Discount' (tag) or 'Free gift' (gift box).
    Anything else renders the gift box.

  @example
  {% render 'cart-rewards-icon', reward_type: 'Free shipping' %}
{% enddoc %}

<svg
  class="cart-rewards__icon"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case reward_type -%}
    {%- when 'Free shipping' -%}
      <path d="M5.1 16.1H2.75V6.1h10.75v10H8.9" />
      <path d="M13.5 9.4h4.1l3.65 3.6v3.1H18.9M15.1 16.1h-1.6" />
      <circle cx="7" cy="16.1" r="1.9" />
      <circle cx="17" cy="16.1" r="1.9" />
    {%- when 'Discount' -%}
      <path
        d="M11.4 3.25h8.1a1.25 1.25 0 0 1 1.25 1.25v7.9a1.25 1.25 0 0 1-.37.88l-8.5 8.5a1.9 1.9 0 0 1-2.7 0l-6.6-6.6a1.9 1.9 0 0 1 0-2.7l8.5-8.5a1.25 1.25 0 0 1 .42-.73z"
      />
      <circle cx="16.4" cy="7.6" r="1.15" />
    {%- else -%}
      <path d="M3.5 8h17v4h-17z" />
      <path d="M4.75 12v7.5a1 1 0 0 0 1 1h12.5a1 1 0 0 0 1-1V12" />
      <path d="M12 8v12.5" />
      <path d="M12 8H8.5a2.25 2.25 0 1 1 0-4.5C10.8 3.5 12 5.5 12 8z" />
      <path d="M12 8h3.5a2.25 2.25 0 1 0 0-4.5C13.2 3.5 12 5.5 12 8z" />
  {%- endcase -%}
</svg>
