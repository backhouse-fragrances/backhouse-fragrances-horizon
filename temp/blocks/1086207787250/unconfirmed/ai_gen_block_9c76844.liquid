{% doc %}
  @prompt
    Create a split-layout product highlight block for a corporate gifting page. One half should display a selectable product and link to that product’s page, like a product highlight. The other half should contain editable heading and text instead of a separate lifestyle image. Use an equal-width layout on desktop and stack the two halves on mobile. Match the theme’s existing styling., Could youn make the block fill the page on the sides? And also could you have the spacing for the product title a little better maybe making the image smaller so its not as crammed?
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gifting-highlight-{{ ai_gen_id }} {
    display: block;
    width: 100vw;
    max-width: 100vw;
    margin-inline: calc(50% - 50vw);
    color: #1c1c1c;
  }

  .ai-gifting-highlight-{{ ai_gen_id }}__layout {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    width: {{ block.settings.desktop_width_percent }}%;
    margin-inline: auto;
  }

  .ai-gifting-highlight-{{ ai_gen_id }}__product {
    display: flex;
    flex-direction: column;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .ai-gifting-highlight-{{ ai_gen_id }}__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1.2 / 1;
    background: #f4f3f0;
  }

  .ai-gifting-highlight-{{ ai_gen_id }}__media img,
  .ai-gifting-highlight-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-gifting-highlight-{{ ai_gen_id }}__empty {
    position: absolute;
    inset: auto 16px 16px;
    margin: 0;
    color: #333333;
    font-size: 13px;
    text-align: center;
  }

  .ai-gifting-highlight-{{ ai_gen_id }}__product-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    padding: 22px 24px;
    border-bottom: 1px solid #dfdfdf;
  }

  .ai-gifting-highlight-{{ ai_gen_id }}__product-title,
  .ai-gifting-highlight-{{ ai_gen_id }}__price {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
  }

  .ai-gifting-highlight-{{ ai_gen_id }}__product-title {
    flex: 1 1 auto;
    font-weight: 500;
  }

  .ai-gifting-highlight-{{ ai_gen_id }}__price {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .ai-gifting-highlight-{{ ai_gen_id }}__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(28px, 6vw, 88px);
    background: #f4f3f0;
  }

  .ai-gifting-highlight-{{ ai_gen_id }}__heading {
    margin: 0 0 18px;
    color: #1c1c1c;
    font-size: clamp(24px, 3vw, 40px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ai-gifting-highlight-{{ ai_gen_id }}__text {
    color: #1c1c1c;
    font-size: 16px;
    line-height: 1.75;
  }

  .ai-gifting-highlight-{{ ai_gen_id }}__text > *:first-child { margin-top: 0; }
  .ai-gifting-highlight-{{ ai_gen_id }}__text > *:last-child { margin-bottom: 0; }

  .ai-gifting-highlight-{{ ai_gen_id }}__link-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    color: #1c1c1c;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .ai-gifting-highlight-{{ ai_gen_id }}__product:focus-visible,
  .ai-gifting-highlight-{{ ai_gen_id }}__link-label:focus-visible {
    outline: 2px solid #1c1c1c;
    outline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-gifting-highlight-{{ ai_gen_id }}__layout {
      width: 100%;
      grid-template-columns: 1fr;
    }
    .ai-gifting-highlight-{{ ai_gen_id }}__media { aspect-ratio: 1.35 / 1; }
    .ai-gifting-highlight-{{ ai_gen_id }}__product-info { gap: 16px; padding: 18px 16px; }
    .ai-gifting-highlight-{{ ai_gen_id }}__copy { padding: 32px 24px; }
    .ai-gifting-highlight-{{ ai_gen_id }}__heading { font-size: 26px; }
  }
{% endstyle %}

<div class="ai-gifting-highlight-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-gifting-highlight-{{ ai_gen_id }}__layout">
    {% if block.settings.featured_product != blank %}
      <a class="ai-gifting-highlight-{{ ai_gen_id }}__product" href="{{ block.settings.featured_product.url }}" aria-label="{{ block.settings.featured_product.title | escape }}">
        <div class="ai-gifting-highlight-{{ ai_gen_id }}__media">
          {% if block.settings.featured_product.featured_image %}
            <img src="{{ block.settings.featured_product.featured_image | image_url: width: 1200 }}" alt="{{ block.settings.featured_product.featured_image.alt | default: block.settings.featured_product.title | escape }}" loading="lazy" width="{{ block.settings.featured_product.featured_image.width }}" height="{{ block.settings.featured_product.featured_image.height }}">
          {% else %}
            <div class="ai-gifting-highlight-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}<p class="ai-gifting-highlight-{{ ai_gen_id }}__empty">Add a product image to complete this highlight.</p></div>
          {% endif %}
        </div>
        <div class="ai-gifting-highlight-{{ ai_gen_id }}__product-info">
          <h3 class="ai-gifting-highlight-{{ ai_gen_id }}__product-title">{{ block.settings.featured_product.title | escape }}</h3>
          <span class="ai-gifting-highlight-{{ ai_gen_id }}__price">{{ block.settings.featured_product.price | money }}</span>
        </div>
      </a>
    {% else %}
      <div class="ai-gifting-highlight-{{ ai_gen_id }}__media">
        <div class="ai-gifting-highlight-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}<p class="ai-gifting-highlight-{{ ai_gen_id }}__empty">Select a product to feature here.</p></div>
      </div>
    {% endif %}

    <div class="ai-gifting-highlight-{{ ai_gen_id }}__copy">
      {% if block.settings.heading != blank %}<h2 class="ai-gifting-highlight-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
      {% if block.settings.description != blank %}<div class="ai-gifting-highlight-{{ ai_gen_id }}__text">{{ block.settings.description }}</div>{% endif %}
      {% if block.settings.featured_product != blank %}<a class="ai-gifting-highlight-{{ ai_gen_id }}__link-label" href="{{ block.settings.featured_product.url }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Gifting product highlight",
  "settings": [
    { "type": "product", "id": "featured_product", "label": "Featured product" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Thoughtful gifting, beautifully done" },
    { "type": "richtext", "id": "description", "label": "Text", "default": "<p>Discover considered gifts for clients, teams, and meaningful occasions. Each detail is chosen to leave a lasting impression.</p>" },
    { "type": "text", "id": "link_label", "label": "Product link label", "default": "Explore the product" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop content width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Gifting product highlight" }],
  "tag": null,
  "class": "gifting-product-highlight"
}
{% endschema %}